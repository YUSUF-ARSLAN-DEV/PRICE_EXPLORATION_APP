{
  "name": "qarib",
  "private": true,
  "version": "0.1.0",
  "description": "Qatar grocery price comparison - monorepo (see plan.txt)",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "up": "docker compose up -d",
    "down": "docker compose down",
    "reset": "docker compose down -v && docker compose up -d",
    "seed": "pnpm --filter @qarib/db seed",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:plan": "node scripts/check-plan-deviation.mjs",
    "prepare": "node -e \"try{require('child_process').execSync('git config core.hooksPath',{stdio:'ignore'})}catch(e){}\"",
    "db:migrate": "pnpm --filter @qarib/db migrate",
    "db:down": "pnpm --filter @qarib/db migrate:down",
    "db:status": "pnpm --filter @qarib/db migrate:status",
    "gen:fixtures": "python scripts/gen-fixtures.py"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^19.5.0",
    "prettier": "^3.3.3",
    "turbo": "^2.3.0",
    "typescript": "^5.6.3"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.12"
    }
  }
}
