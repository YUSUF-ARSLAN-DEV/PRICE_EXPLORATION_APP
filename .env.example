# Copy to .env for local development. NEVER commit .env or real secrets.
# Production/staging secrets live in Azure Key Vault (plan 8.2), not in files.

# --- Postgres (docker compose) ---
POSTGRES_USER=qarib
POSTGRES_PASSWORD=qarib_local_only
POSTGRES_DB=qarib
DATABASE_URL=postgresql://qarib:qarib_local_only@localhost:5432/qarib

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Meilisearch ---
MEILI_MASTER_KEY=local_master_key_change_me_32chars_min
MEILI_URL=http://localhost:7700

# --- Azurite (Azure Blob emulator; well-known public dev key, NOT a secret) ---
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://localhost:10000/devstoreaccount1;

# --- Mail (Mailpit catches all mail locally) ---
SMTP_HOST=localhost
SMTP_PORT=1025

# --- App ---
API_PORT=4000
WEB_PORT=3000
ADMIN_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:4000
APP_ENV=local
# Bot identity (plan P4). Replace with real .qa domain once registered (ADR-005).
INGEST_USER_AGENT=QaribBot/1.0 (+https://example.qa/bot; legal@example.qa)
