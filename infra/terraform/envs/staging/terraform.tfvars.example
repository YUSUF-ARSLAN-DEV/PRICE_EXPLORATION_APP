# Copy to terraform.tfvars (git-ignored) and fill in. No secrets here: secrets are generated by
# Terraform into Key Vault. Decisions marked CONFIRM depend on the step 9.0 availability results.
subscription_id = "<azure subscription id of the COMPANY account>"
environment     = "staging"
location        = "qatarcentral"

# CONFIRM in step 9.0: zones + HA exist in Qatar Central for each service. If not, use [] / Disabled / false.
availability_zones = []
zone_redundant     = false
postgres_ha_mode   = "Disabled"

postgres_sku                   = "GP_Standard_D2ds_v5"
postgres_storage_mb            = 65536
postgres_backup_retention_days = 14

web_min_replicas = 1
web_max_replicas = 3
api_min_replicas = 1
api_max_replicas = 3
monthly_budget   = 600

public_hostname = "staging.example.qa"
admin_hostname  = "admin.staging.example.qa"
waf_mode        = "Prevention"

# Office / VPN egress ranges allowed to reach the admin console (never 0.0.0.0/0).
admin_allowed_cidrs = ["203.0.113.0/24"]
key_vault_allowed_ips = [] # CI runner / admin public IPs that manage secrets

log_retention_days = 30 # prod: >= backup retention so erasure logs outlive restores (runbooks/disaster-recovery.md)
alert_emails = ["oncall@example.qa"]

# Two-phase edge: apply with enable_edge=false, import the TLS certificate into Key Vault, then true.
enable_edge               = false
tls_certificate_secret_id = ""

manage_dns    = false # true once the .qa domain is registered to the company (ADR-005)
dns_zone_name = "example.qa"

legal_email       = "legal@example.qa"
mail_from         = "Qarib <no-reply@example.qa>"
smtp_host         = "smtp.example.qa"
ingest_user_agent = "QaribBot/1.0 (+https://staging.example.qa/bot; legal@example.qa)"

# Soft launch (docs/runbooks/soft-launch.md): "off" until the beta reaches day 14.
site_indexing = "off"
